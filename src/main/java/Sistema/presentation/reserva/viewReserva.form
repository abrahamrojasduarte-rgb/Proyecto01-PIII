<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Sistema.presentation.reserva.viewReserva">
  <grid id="b1000" binding="panelReserva" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="880" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="b1100" binding="nuevaReservaPanel" layout-manager="GridLayoutManager" row-count="6" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="6" left="6" bottom="6" right="6"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Nueva reserva"/>
        <children>
          <component id="b1101" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Frase"/>
            </properties>
          </component>
          <scrollpane id="b1102" binding="fraseScroll">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="420" height="60"/>
              </grid>
            </constraints>
            <properties/>
            <border type="line"/>
            <children>
              <component id="b1103" class="javax.swing.JTextArea" binding="fraseTxt">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <rows value="3"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <component id="b1104" class="javax.swing.JButton" binding="extraerButton">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Extraer con IA"/>
            </properties>
          </component>
          <component id="b1105" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Actividad"/>
            </properties>
          </component>
          <component id="b1106" class="javax.swing.JTextField" binding="actividadTxt">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="420" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <hspacer id="b1107">
            <constraints>
              <grid row="1" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="b1108" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha"/>
            </properties>
          </component>
          <component id="b1109" class="com.github.lgooddatepicker.components.DatePicker" binding="datePicker">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="b1110" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora inicio"/>
            </properties>
          </component>
          <component id="b1111" class="javax.swing.JComboBox" binding="horaInicioCombo">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="140" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <model/>
            </properties>
          </component>
          <component id="b1112" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora fin"/>
            </properties>
          </component>
          <component id="b1113" class="javax.swing.JComboBox" binding="horaFinCombo">
            <constraints>
              <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="140" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <model/>
            </properties>
          </component>
          <grid id="b1114" binding="categoriasPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="4" left="4" bottom="4" right="4"/>
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="5" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="etched" title="Categorias requeridas (seleccion multiple)"/>
            <children>
              <scrollpane id="b1115" binding="categoriasScroll">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="110"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="b1116" class="javax.swing.JList" binding="categoriasList">
                    <constraints/>
                    <properties>
                      <selectionMode value="2"/>
                      <visibleRowCount value="5"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="b1117" binding="botonesPanel" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="4" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="5" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <hspacer id="b1118">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <component id="b1119" class="javax.swing.JButton" binding="reservarButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Reservar"/>
                </properties>
              </component>
              <component id="b1120" class="javax.swing.JButton" binding="cancelarButton">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancelar reserva seleccionada"/>
                </properties>
              </component>
              <component id="b1121" class="javax.swing.JButton" binding="limpiarButton">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Limpiar"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="b1200" binding="misReservasPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="6" left="6" bottom="6" right="6"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Mis reservas"/>
        <children>
          <scrollpane id="b1201" binding="reservasScroll">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="180"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="b1202" class="javax.swing.JTable" binding="reservasTable">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="b1203" class="javax.swing.JButton" binding="imprimirButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Imprimir"/>
            </properties>
          </component>
        </children>
      </grid>
      <vspacer id="b1300">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
